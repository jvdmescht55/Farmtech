# Used only when running the worker directly on the host (`cd worker && node
# src/pipeline.js ...`) — dotenv loads .env relative to the current working
# directory, so this file must live here, not at the repo root.
#
# Running via `docker compose exec worker ...` instead? You don't need this
# file: docker-compose.yml's `env_file: .env` already injects the repo-root
# .env into the container, and those values take precedence over anything
# dotenv would load here.
#
# Copy this to worker/.env and fill in real values.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used to clean up (not fabricate) the first/hero product photo — background,
# lighting, crop. Requires an image-capable model + a billing-enabled
# project; falls back to the original unedited photo on any failure
# (including simply not having quota for image models).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

USD_ZAR_API_KEY=
USD_ZAR_API_URL=https://v6.exchangerate-api.com/v6

DEFAULT_TARGET_MARGIN_PCT=35
DEFAULT_AIR_FREIGHT_USD_PER_KG=9.5
DEFAULT_CLEARING_AGENT_FEE_ZAR=450
DEFAULT_VAT_RATE=0.15

WORKER_UPLOAD_DIR=../public/uploads/products

# --- MySQL (default — matches the Docker/production setup) ---
WORKER_DB_HOST=127.0.0.1
WORKER_DB_PORT=3306
WORKER_DB_DATABASE=farmtech
WORKER_DB_USERNAME=farmtech
WORKER_DB_PASSWORD=secret

# --- SQLite (alternative — no MySQL/Docker required) ---
# Uncomment both to switch drivers. Must point at the SAME database.sqlite
# the Laravel app uses (config/database.php), or inserted products won't
# show up in /admin.
# WORKER_DB_DRIVER=sqlite
# WORKER_SQLITE_PATH=../database/database.sqlite
