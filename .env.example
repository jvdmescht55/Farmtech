APP_NAME=Farmtech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_FORCE_HTTPS=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (matches docker-compose.yml service `mysql`) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=farmtech
DB_USERNAME=farmtech
DB_PASSWORD=secret
# Root password used only by the mysql container itself
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- AI vetting (worker) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Live USD/ZAR forex feed (worker) ---
# Get a free key at https://www.exchangerate-api.com/ — pipeline falls back
# to the last rate stored in the exchange_rates table if this is unset/offline.
USD_ZAR_API_KEY=
USD_ZAR_API_URL=https://v6.exchangerate-api.com/v6

# --- Landed-cost defaults (seeded into the `settings` table on first migrate) ---
DEFAULT_TARGET_MARGIN_PCT=35
DEFAULT_AIR_FREIGHT_USD_PER_KG=9.5
DEFAULT_CLEARING_AGENT_FEE_ZAR=450
DEFAULT_VAT_RATE=0.15

# --- SA payment gateways (sandbox scaffolding — leave blank until you have real creds) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_SANDBOX=true

YOCO_PUBLIC_KEY=
YOCO_SECRET_KEY=

# --- SA courier scaffolding ---
COURIER_GUY_API_KEY=
COURIER_GUY_ACCOUNT_NUMBER=
DHL_API_KEY=
DHL_ACCOUNT_NUMBER=

# --- Admin bootstrap account (used only by database/seeders/AdminUserSeeder.php) ---
ADMIN_NAME="Farmtech Admin"
ADMIN_EMAIL=admin@farmtech.co.za
ADMIN_PASSWORD=change-me-immediately

# --- Node worker, Docker path only ---
# docker-compose.yml injects this whole file into the `worker` container via
# env_file, so these values are what `docker compose exec worker node
# src/pipeline.js ...` actually uses. WORKER_UPLOAD_DIR/WORKER_DB_HOST are
# overridden inside the container regardless (see docker-compose.yml).
# Running the worker directly on the host instead (no Docker)? See
# worker/.env.example — dotenv reads relative to cwd, so these values here
# are NOT picked up in that case.
WORKER_UPLOAD_DIR=./public/uploads/products
WORKER_DB_HOST=mysql
WORKER_DB_PORT=3306
WORKER_DB_DATABASE=farmtech
WORKER_DB_USERNAME=farmtech
WORKER_DB_PASSWORD=secret
